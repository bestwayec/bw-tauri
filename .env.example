# Copy to `.env` for local dev (never commit `.env`).
#
# Backend base URL — MUST include the `/v1` prefix.
# Local development uses loopback HTTP; the unset default is https://api.bestwayec.uz/v1.
# Release builds MUST use HTTPS. Native refresh/logout validate the exact API base.
# Export this variable to both Vite and Cargo before a staging/custom Tauri build;
# putting it only in this .env file configures Vite, not Rust. See README.md.
VITE_API_URL=http://localhost:3001/v1

# System-browser login page origin (OAuth desktop flow).
VITE_WEB_URL=http://localhost:3005
