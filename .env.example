# Copy to `.env` for local dev (never commit `.env`).
#
# Backend base URL — MUST include the `/v1` prefix.
# Local dev default: http://localhost:3001/v1
# Release builds MUST set this to the production backend over https, e.g.
# https://api.bestway.uz/v1 — otherwise the app falls back to the student's
# own localhost and shows an empty exam list (fail-loud banner included).
VITE_API_URL=http://localhost:3001/v1

# System-browser login page origin (OAuth desktop flow).
VITE_WEB_URL=http://localhost:3005
