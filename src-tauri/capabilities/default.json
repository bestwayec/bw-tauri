{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege: core window controls for kiosk + tray background + opener/deep-link for browser login + clipboard wipe on lock + signed auto-updater (single-instance plugin has no permissions)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:tray:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-focus",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://**" },
        { "url": "http://localhost:**" },
        { "url": "http://127.0.0.1:**" }
      ]
    },
    "deep-link:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-clear"
  ]
}
